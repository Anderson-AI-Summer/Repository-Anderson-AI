<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>NASA Procurement Intelligence Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root {
  --navy: #0b1f3a;
  --navy-2: #0f2a52;
  --blue: #2a6df4;
  --red: #d0392b;
  --bg: #f4f6fa;
  --panel: #ffffff;
  --border: #dfe4ee;
  --text: #182338;
  --text-muted: #5b6579;
  --ok: #1f8a4c;
  --warn: #b5790a;
  --nasa-blue: #0b3d91;
  --nasa-red: #fc3d21;
}
* { box-sizing: border-box; }
body {
  margin: 0; font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  background: var(--bg); color: var(--text); font-size: 14px;
}
header.top {
  background:
    radial-gradient(circle at 12% 22%, rgba(255,255,255,0.10) 0, transparent 1.4px),
    radial-gradient(circle at 78% 55%, rgba(255,255,255,0.08) 0, transparent 1.2px),
    radial-gradient(circle at 45% 80%, rgba(255,255,255,0.07) 0, transparent 1.1px),
    radial-gradient(circle at 92% 15%, rgba(255,255,255,0.09) 0, transparent 1.3px),
    linear-gradient(120deg, var(--navy), var(--navy-2));
  background-size: 140px 140px, 160px 160px, 130px 130px, 150px 150px, 100% 100%;
  color: #fff; padding: 18px 28px;
}
.header-row { display: flex; align-items: center; gap: 14px; }
.nasa-mark { flex: 0 0 auto; }
.header-title-block { flex: 1 1 auto; min-width: 0; }
.header-title-block .title-line { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.nasa-wordmark {
  font-weight: 800; letter-spacing: 1.5px; font-size: 15px;
  background: linear-gradient(90deg, var(--nasa-red), #ff8a68);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.unofficial-badge {
  display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.4px;
  text-transform: uppercase; color: #ffcf9e; border: 1px solid rgba(255,207,158,0.5);
  border-radius: 10px; padding: 1px 8px; margin-left: 2px;
}
header.top h1 { margin: 0; font-size: 21px; letter-spacing: 0.3px; }
header.top .disclosure { font-size: 12px; color: #ffcf9e; margin: 6px 0 10px 0; }
.meta-bar { display: flex; flex-wrap: wrap; gap: 18px; font-size: 12.5px; color: #cfd9ef; }
.meta-bar b { color: #fff; }
.meta-bar .badge {
  background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25);
  border-radius: 4px; padding: 2px 8px;
}
nav.tabs {
  display: flex; background: #fff; border-bottom: 2px solid var(--border);
  padding: 0 20px; position: sticky; top: 0; z-index: 20; overflow-x: auto;
}
nav.tabs button {
  background: none; border: none; padding: 13px 18px; font-size: 13.5px;
  cursor: pointer; color: var(--text-muted); border-bottom: 3px solid transparent;
  white-space: nowrap; font-weight: 600;
}
nav.tabs button.active { color: var(--blue); border-bottom-color: var(--blue); }
nav.tabs button:hover { color: var(--navy); }
main { padding: 20px 24px 60px; max-width: 1440px; margin: 0 auto; }
.tab-panel { display: none; }
.tab-panel.active { display: block; }
.warning-banner {
  background: #fff6e6; border: 1px solid #f0c877; color: #7a5300;
  padding: 10px 14px; border-radius: 6px; font-size: 12.5px; margin-bottom: 16px;
}
.kpi-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 18px; }
.kpi {
  background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
  padding: 12px 14px;
}
.kpi .label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; color: var(--text-muted); margin-bottom: 6px; }
.kpi .value { font-size: 19px; font-weight: 700; color: var(--navy); }
.kpi .value.neg { color: var(--red); }
.panel {
  background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
  padding: 16px; margin-bottom: 18px;
}
.panel h2 { margin: 0 0 12px 0; font-size: 15px; color: var(--navy); }
.panel h3 { margin: 14px 0 8px; font-size: 13px; color: var(--navy-2); }
.grid-2 { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
@media (max-width: 900px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }
table.data-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
table.data-table th {
  text-align: left; background: #eef2f9; color: var(--navy-2); padding: 7px 8px;
  border-bottom: 1px solid var(--border); cursor: pointer; user-select: none; position: sticky; top: 0;
}
table.data-table th.sortable:hover { background: #e2e9f6; }
table.data-table td { padding: 6px 8px; border-bottom: 1px solid #eef1f6; vertical-align: top; }
table.data-table tr:hover td { background: #f8fafd; }
.pos { color: var(--ok); } .neg { color: var(--red); }
.flag-pill {
  display: inline-block; background: #fdeeee; color: var(--red); border-radius: 10px;
  font-size: 10.5px; padding: 1px 7px; margin: 1px 2px 1px 0;
}
.flag-pill.review { background: #fff3d9; color: var(--warn); }
.controls { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; align-items: center; }
.controls label { font-size: 11.5px; color: var(--text-muted); display: block; margin-bottom: 3px; }
.controls select, .controls input {
  padding: 6px 8px; border: 1px solid var(--border); border-radius: 5px; font-size: 12.5px; min-width: 130px;
}
.controls button {
  background: var(--blue); color: #fff; border: none; border-radius: 5px; padding: 7px 14px;
  font-size: 12.5px; cursor: pointer; font-weight: 600;
}
.controls button.secondary { background: var(--navy-2); }
.table-wrap { max-height: 560px; overflow: auto; border: 1px solid var(--border); border-radius: 6px; }
.finding-card {
  border-left: 3px solid var(--blue); background: #f6f9ff; padding: 10px 12px;
  border-radius: 4px; margin-bottom: 10px; font-size: 12.5px;
}
.finding-card h4 { margin: 0 0 4px 0; font-size: 13px; color: var(--navy); }
.finding-card .metrics { color: var(--text-muted); font-size: 11.5px; margin-top: 6px; }
.small-note { font-size: 11px; color: var(--text-muted); margin-top: 6px; }
.chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0; }
.chip { background: #eef2f9; border-radius: 12px; padding: 3px 10px; font-size: 11.5px; color: var(--navy-2); }
footer { text-align: center; padding: 20px; color: var(--text-muted); font-size: 11.5px; }

.standout-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
.standout-card {
  border: 1px solid var(--border); border-left: 4px solid var(--nasa-blue); border-radius: 8px;
  padding: 12px 14px; background: #fbfcfe;
}
.standout-card .sc-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 4px; }
.standout-card .sc-name { font-weight: 700; color: var(--navy); font-size: 13.5px; }
.standout-card .sc-amount { font-weight: 700; color: var(--navy-2); font-size: 13px; white-space: nowrap; }
.standout-card .sc-sub { font-size: 11px; color: var(--text-muted); margin-bottom: 8px; }
.reason-tag {
  display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; font-weight: 600;
  border-radius: 10px; padding: 2px 8px; margin: 0 4px 4px 0;
}
.reason-tag.high_concentration { background: #eaf0ff; color: var(--nasa-blue); }
.reason-tag.deobligation_flag { background: #fdeeee; color: var(--red); }
.reason-tag.rapid_growth { background: #e9f8ee; color: var(--ok); }
.reason-tag.rapid_decline { background: #fff3d9; color: var(--warn); }
.standout-card .sc-reason-detail { font-size: 11.5px; color: var(--text); margin: 4px 0 8px; }
.standout-card .sc-reason-detail:last-of-type { margin-bottom: 10px; }
.sc-actions { display: flex; flex-wrap: wrap; gap: 6px; }
.sc-actions button {
  font-size: 11px; font-weight: 600; border-radius: 5px; padding: 5px 9px; cursor: pointer;
  border: 1px solid var(--border); background: #fff; color: var(--navy-2);
}
.sc-actions button.primary { background: var(--blue); color: #fff; border-color: var(--blue); }
.sc-actions button.flag-btn.marked { background: #fff3d9; color: var(--warn); border-color: #f0c877; }
.sc-actions button:hover { filter: brightness(0.96); }
</style>
</head>
<body>

<header class="top">
  <div class="header-row">
    <div class="nasa-mark" title="Stylized mark -- not the official NASA insignia">
      <svg width="46" height="46" viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="23" cy="23" r="21" fill="#0b3d91" stroke="#ffffff" stroke-width="1.5"/>
        <ellipse cx="23" cy="23" rx="19" ry="7" fill="none" stroke="#ffffff" stroke-width="1.1" opacity="0.55"/>
        <ellipse cx="23" cy="23" rx="19" ry="7" fill="none" stroke="#ffffff" stroke-width="1.1" opacity="0.55" transform="rotate(60 23 23)"/>
        <ellipse cx="23" cy="23" rx="19" ry="7" fill="none" stroke="#ffffff" stroke-width="1.1" opacity="0.55" transform="rotate(120 23 23)"/>
        <path d="M23 10 C 25 16, 25 30, 23 36 C 21 30, 21 16, 23 10 Z" fill="#fc3d21"/>
        <circle cx="23" cy="23" r="2.6" fill="#ffffff"/>
      </svg>
    </div>
    <div class="header-title-block">
      <div class="title-line">
        <h1 id="dash-title">NASA Procurement Intelligence Dashboard</h1>
        <span class="nasa-wordmark">NASA</span>
        <span class="unofficial-badge">Unofficial · Not NASA-affiliated</span>
      </div>
      <div class="disclosure" id="dash-disclosure"></div>
      <div class="meta-bar" id="meta-bar"></div>
    </div>
  </div>
</header>

<nav class="tabs">
  <button data-tab="overview" class="active">Executive Overview</button>
  <button data-tab="yoy">Year-over-Year Trends</button>
  <button data-tab="explorer">Transaction Explorer</button>
  <button data-tab="supplier">Supplier Analysis</button>
  <button data-tab="categories">Categories &amp; Opportunities</button>
</nav>

<main>

  <!-- ================= TAB 1: EXECUTIVE OVERVIEW ================= -->
  <section id="tab-overview" class="tab-panel active">
    <div id="overview-warning"></div>
    <div class="kpi-row" id="overview-kpis"></div>
    <div class="grid-2">
      <div class="panel"><h2>Annual Obligation Trend</h2><div id="chart-annual-trend" style="height:320px;"></div></div>
      <div class="panel"><h2>Category Composition (Net Obligations)</h2><div id="chart-category-comp" style="height:320px;"></div></div>
    </div>
    <div class="grid-2">
      <div class="panel">
        <h2>Top Suppliers</h2>
        <div class="table-wrap"><table class="data-table" id="table-top-suppliers"></table></div>
      </div>
      <div class="panel">
        <h2>Key Findings</h2>
        <div id="overview-findings"></div>
      </div>
    </div>
    <div class="panel">
      <h2>Standout Suppliers</h2>
      <div class="small-note">
        Up to 5 suppliers surfaced by disclosed, evidence-based signals (spend
        concentration, deobligation share, year-over-year swings) -- not a
        performance rating or a finding of wrongdoing. Each reason cites the
        exact supporting metric so it can be checked against the award record.
      </div>
      <div class="standout-grid" id="standout-suppliers" style="margin-top:10px;"></div>
    </div>
  </section>

  <!-- ================= TAB 2: YEAR-OVER-YEAR TRENDS ================= -->
  <section id="tab-yoy" class="tab-panel">
    <div id="yoy-warning"></div>
    <div class="controls">
      <div><label>Compare from FY</label><select id="yoy-fy-from"></select></div>
      <div><label>to FY</label><select id="yoy-fy-to"></select></div>
      <div><label>View</label><select id="yoy-view"><option value="full">Full fiscal year</option><option value="ytd">Comparable year-to-date</option></select></div>
    </div>
    <div class="grid-2">
      <div class="panel"><h2>Net &amp; Gross Obligations by Fiscal Year</h2><div id="chart-yoy-obligations" style="height:300px;"></div></div>
      <div class="panel"><h2>Deobligations by Fiscal Year</h2><div id="chart-yoy-deob" style="height:300px;"></div></div>
    </div>
    <div class="grid-2">
      <div class="panel"><h2>Supplier &amp; Award Counts</h2><div id="chart-yoy-counts" style="height:300px;"></div></div>
      <div class="panel"><h2>Supplier Concentration Trend (HHI &amp; Top-5 Share)</h2><div id="chart-yoy-concentration" style="height:300px;"></div></div>
    </div>
    <div class="panel"><h2>Category Trends (Top Categories)</h2><div id="chart-yoy-category" style="height:340px;"></div></div>
    <div class="panel">
      <h2>FY Comparison Table</h2>
      <div class="table-wrap"><table class="data-table" id="table-yoy"></table></div>
    </div>
  </section>

  <!-- ================= TAB 3: TRANSACTION EXPLORER ================= -->
  <section id="tab-explorer" class="tab-panel">
    <div class="panel">
      <div class="small-note" id="explorer-disclosure"></div>
      <div class="controls">
        <div><label>Search</label><input id="ex-search" type="text" placeholder="supplier, award ID, description..."></div>
        <div><label>Fiscal Year</label><select id="ex-fy"><option value="">All</option></select></div>
        <div><label>Supplier</label><select id="ex-supplier"><option value="">All</option></select></div>
        <div><label>Category</label><select id="ex-category"><option value="">All</option></select></div>
        <div><label>Direction</label><select id="ex-direction"><option value="">All</option><option>OBLIGATION</option><option>DEOBLIGATION</option><option>ZERO_DOLLAR_ACTION</option></select></div>
        <div><label>Min. Confidence</label><input id="ex-confidence" type="number" min="0" max="1" step="0.05" value="0"></div>
        <div><label>Min. |Amount| ($)</label><input id="ex-amount" type="number" min="0" step="1000" value="0"></div>
        <div style="align-self:flex-end;"><button id="ex-export">Export filtered CSV</button></div>
        <div style="align-self:flex-end;"><button id="ex-reset" class="secondary">Reset filters</button></div>
      </div>
      <div class="small-note" id="explorer-count"></div>
      <div class="table-wrap"><table class="data-table" id="table-explorer"></table></div>
    </div>
  </section>

  <!-- ================= TAB 4: SUPPLIER ANALYSIS ================= -->
  <section id="tab-supplier" class="tab-panel">
    <div class="panel">
      <div class="controls">
        <div style="min-width:280px;"><label>Select supplier</label><select id="supplier-select"></select></div>
      </div>
      <div class="kpi-row" id="supplier-kpis"></div>
      <div class="grid-2">
        <div><h3>Annual Net Obligations</h3><div id="chart-supplier-annual" style="height:260px;"></div></div>
        <div><h3>Category Mix</h3><div id="chart-supplier-category" style="height:260px;"></div></div>
      </div>
      <div class="grid-2">
        <div>
          <h3>Raw Name Variants Consolidated</h3>
          <div class="chip-row" id="supplier-variants"></div>
          <h3>Resolution Evidence</h3>
          <div id="supplier-evidence" class="small-note"></div>
        </div>
        <div>
          <h3>NASA Awarding Offices</h3>
          <div class="chip-row" id="supplier-offices"></div>
          <h3>Flags</h3>
          <div id="supplier-flags"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TAB 5: CATEGORIES & OPPORTUNITIES ================= -->
  <section id="tab-categories" class="tab-panel">
    <div class="panel">
      <div class="controls">
        <div style="min-width:280px;"><label>Select category</label><select id="category-select"></select></div>
      </div>
      <div class="kpi-row" id="category-kpis"></div>
      <div class="grid-2">
        <div><h3>Annual Trend</h3><div id="chart-category-annual" style="height:260px;"></div></div>
        <div>
          <h3>Leading Suppliers</h3>
          <div class="table-wrap"><table class="data-table" id="table-category-suppliers"></table></div>
        </div>
      </div>
      <h2>Grounded AI Insights (this category)</h2>
      <div id="category-findings"></div>
      <h2>Data Quality Summary</h2>
      <div class="kpi-row" id="category-quality-kpis"></div>
      <h2>Low-Confidence Review Queue</h2>
      <div class="table-wrap"><table class="data-table" id="table-review-queue"></table></div>
    </div>
  </section>

</main>

<footer>
  NASA Procurement Intelligence Dashboard — unofficial educational project, not affiliated with or endorsed by NASA.
  Generated {{ generated_at }} · Data via USAspending.gov.
</footer>

<script id="dashboard-data" type="application/json">{{ payload_json }}</script>
<script>
{{ plotly_js }}
</script>
<script>
{{ app_js }}
</script>
</body>
</html>
