# Copy this file to .env and fill in real values. Never commit .env.
#
# Optional: enables LIVE_AGENT mode for the three-agent workflow.
# Without it, the pipeline runs in DETERMINISTIC_FALLBACK mode automatically.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model used by the agents.
ANTHROPIC_MODEL=claude-sonnet-5
